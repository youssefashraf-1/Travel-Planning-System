# Replace with your own connection string in .env; never commit credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/travel_planning_system
PORT=3000

# Secret for signing login tokens. Generate your own, for example with:
#   openssl rand -base64 48
# Use at least 32 characters and never commit the real value.
JWT_ACCESS_SECRET=

# Administrator account created by npm run seed:admin (ACC-18).
# Use your own values; the password needs 8+ characters, a letter and a digit.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe in test mode (PAY-01 to PAY-03). Get the secret key from
# https://dashboard.stripe.com/test/apikeys (it starts with sk_test_).
# Never commit real values; never use an sk_live_ key here.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_...). Locally, `stripe listen --forward-to
# localhost:3000/api/payments/webhook` prints one. Without it, payments are
# still verified by GET /api/payments/:id and the test card shortcut.
STRIPE_WEBHOOK_SECRET=

# Exchange rates for itinerary budgets (ITN-18) come from FXRatesAPI through
# the backend. It works without a key; set one only if you have an account.
FXRATES_API_KEY=

# Where uploaded images are stored (GEN-08). Defaults to backend/uploads.
UPLOADS_DIR=

# Account emails (optional ACC-02 verification and ACC-07 password reset) are
# sent through SMTP. Use a test inbox in development, e.g. Ethereal
# (https://ethereal.email) or Mailtrap. Without SMTP_HOST, emails are printed
# in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Base URLs used in emailed links: the API (verification) and the frontend
# (password reset page). Defaults: http://localhost:<PORT> and
# http://localhost:3001.
API_PUBLIC_URL=
FRONTEND_URL=

# Disposable database for npm run test:e2e. Never point it at the shared
# team database; its name must contain "test".
MONGODB_TEST_URI=mongodb://127.0.0.1:27018/travel_planning_system_test

# Optional NestJS Observe configuration.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
